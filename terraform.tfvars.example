# Exemplo de configuração para terraform.tfvars
# Copie este arquivo para terraform.tfvars e ajuste os valores

# Ambiente (dev ou prod)
environment = "dev"

# Nome do cluster ECS
cluster_name = "bia-dev-cluster"

# Nome da chave SSH para instâncias EC2 (opcional)
# key_name = "my-key-pair"

# Configurações específicas do ambiente são definidas em locals.tf
# Este arquivo serve apenas para variáveis que podem mudar entre deployments